# Copy the lines you need into .env.local (which git ignores). Never commit a real key.

# Turns on the AI Coach. Set one of these two keys (both are free).

# Groq (used first when set). Get a free key at https://console.groq.com/keys
GROQ_API_KEY=
# Optional. gpt-oss-120b is the Groq model with built-in web search.
# GROQ_MODEL=openai/gpt-oss-120b

# Google Gemini. Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional. Gemini 2.5 Flash is the model whose free tier includes Google Search grounding.
# GEMINI_MODEL=gemini-2.5-flash

# Optional. If both keys are set, force one: groq or gemini.
# AI_PROVIDER=groq
